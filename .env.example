OUTBOUND_MODE=dry_run              # dry_run | sandbox | live
OUTBOUND_ALLOWLIST=                # comma-separated phones/emails for sandbox mode; discord:<webhook id> or discord:* for Discord
ALERT_AUTHORITIES=false
AUTHORITY_NUMBER=
DEFAULT_TRUSTED_CONTACT=
OPENROUTER_API_KEY=
MODEL_DEFAULT=deepseek/deepseek-v4-flash
MODEL_DRAFTING=
EMBEDDING_PROVIDER=openrouter      # openrouter | fastembed | hash
EMBEDDING_MODEL=baai/bge-m3
MATCH_THRESHOLD=0.50
MATCH_MARGIN=0.05                 # also require being within this of the best score (0 = off)
MATCH_THRESHOLD_HASH=0.2          # used when falling back to the offline hashing embedder
MATCH_TOP_K=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GEOCODER=nominatim                 # nominatim (OpenStreetMap, free, no key) | google
NOMINATIM_EMAIL=                   # your contact email, sent to OpenStreetMap as their usage policy asks
GOOGLE_MAPS_API_KEY=               # backend geocoding
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=   # frontend embed
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=Awaaz
EMAIL_REPLY_TO=
ESCALATION_DELAY_SECONDS=86400
ADDRESSED_STATUSES=IN_PROGRESS,RESOLVED,REJECTED
AGENT_TIMEOUT_S=45
TRACKING_INTERVAL_S=120
TRACKING_MAX_UPDATES=10
PURGE_TRANSCRIPT=true
DATA_ENCRYPTION_KEY=
POLICE_SERVICE_KEY=change-me
POLICE_DEMO_USER=officer
POLICE_DEMO_PASSWORD=awaaz-demo
ENABLE_DEMO_ROUTES=true
DEFAULT_COUNTRY=PK
SEED_EMAIL_BASE=                   # e.g. you@gmail.com -> you+community1@gmail.com in seed data
NEXT_PUBLIC_API_URL=                # empty: the frontend proxies /api to BACKEND_URL (needed for phone access)
BACKEND_URL=http://127.0.0.1:8000
